    },
    {
      "id": "education",
      "name": "Education",
      "componentPath": "src/components/EducationSection.tsx",
      "required": false
    },
    {
      "id": "experience",
      "name": "Experience",
      "componentPath": "src/components/ExperienceSection.tsx",
      "required": false
    },
    {
      "id": "projects",
      "name": "Projects",
      "componentPath": "src/components/ProjectsSection.tsx",
      "required": true
    },
    {
      "id": "skills",
      "name": "Technical Skills",
      "componentPath": "src/components/SkillsSection.tsx",
      "required": true
    },
    {
      "id": "certificates",
      "name": "Certifications",
      "componentPath": "src/components/CertificatesSection.tsx",
      "required": false
    },
    {
      "id": "contact",
